# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./omniagent.db

# ── LLM Providers ─────────────────────────────────────────────────────────────
LLM_PROVIDER=claude           # claude | gpt | ollama | groq | openrouter | nvidia_nim
CLAUDE_API_KEY=               # Anthropic API key
OPENAI_API_KEY=               # OpenAI API key
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=                 # Groq API key
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=           # OpenRouter API key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=          # Optional: used for OpenRouter analytics/ranking
OPENROUTER_APP_NAME=          # Optional: app name sent as X-Title
NVIDIA_NIM_API_KEY=           # NVIDIA NIM API key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
TAVILY_API_KEY=               # Tavily API key used by the web_search skill
TAVILY_BASE_URL=https://api.tavily.com/search

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # @BotFather token
TELEGRAM_WEBHOOK_URL=         # Public HTTPS URL for webhook

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
